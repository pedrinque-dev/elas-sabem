# ============================================
# ELAS SABEM — Variáveis de ambiente (exemplo)
# Copie este arquivo para backend/.env e preencha os valores reais.
# NUNCA faça commit do arquivo .env com valores reais.
# ============================================

# --- Banco de dados ---
# String de conexão do PostgreSQL usada pelo Prisma
DATABASE_URL="postgresql://elas_sabem:senha_super_secreta@localhost:5432/elas_sabem?schema=public"

# --- Autenticação ---
# Use uma string longa e aleatória (ex: openssl rand -base64 48)
JWT_SECRET="troque-por-uma-string-aleatoria-e-longa"
JWT_EXPIRES_IN="8h"

# --- Servidor ---
PORT=3333
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"

# --- IA (Groq) ---
# Chave da API da Groq. Nunca exponha esta chave no frontend.
GROQ_API_KEY="gsk_sua_chave_aqui"
GROQ_MODEL="llama-3.3-70b-versatile"

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AI_RATE_LIMIT_MAX=10

# --- Seed / admin de desenvolvimento ---
SEED_ADMIN_EMAIL="admin@elassabem.org"
SEED_ADMIN_PASSWORD="TrocarEssaSenha123!"
